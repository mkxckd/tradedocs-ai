# Optional. Without a key the assistant uses the deterministic extractive generator.
LLM_PROVIDER=openai        # openai | anthropic
LLM_API_KEY=
LLM_MODEL=                 # defaults: gpt-4.1-mini (openai), claude-haiku-5-5 (anthropic)
LLM_BASE_URL=              # optional, for OpenAI-compatible endpoints
